{
  "name": "@jetdevs/pagekit",
  "version": "0.1.0-dev",
  "description": "Versioned Puck block catalog + section renderers for Jetdevs storefronts: block registry, tombstone rendering, injected data fetcher (zero engine coupling)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.js"
    },
    "./puck": {
      "types": "./dist/puck/index.d.ts",
      "import": "./dist/puck/index.mjs",
      "require": "./dist/puck/index.js"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "jetdevs",
    "pagekit",
    "puck",
    "page-builder",
    "storefront"
  ],
  "author": "Jetdevs",
  "license": "PRIVATE",
  "peerDependencies": {
    "@puckeditor/core": "^0.21.1",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@puckeditor/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@puckeditor/core": "^0.21.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.1",
    "typescript": "^5",
    "vitest": "^3.2.3"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
